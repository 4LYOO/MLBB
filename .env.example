# Copie ce fichier en .env.local. Aucune variable n'est exposée au navigateur
# (aucun préfixe NEXT_PUBLIC_).

# Chemin de la base SQLite (défaut : ./data/mlbb-companion.db)
# DATABASE_PATH=./data/mlbb-companion.db

# Âge (heures) au-delà duquel une statistique est signalée « obsolète » (défaut 48)
# STALE_AFTER_HOURS=48

# --- Connecteurs (voir docs/SOURCES.md) ---
# mlbb.io : synchronisation automatique toutes les N heures (0 = désactivée, défaut 12)
# AUTO_SYNC_HOURS=12
# Pause entre deux requêtes vers mlbb.io, en millisecondes (défaut 1200)
# MLBBIO_DELAY_MS=1200
# Derrière un proxy HTTPS (conteneur cloud) : NODE_USE_ENV_PROXY=1

# Source officielle Moonton : aucune API publique documentée à ce jour.
# Renseigner uniquement si Moonton fournit un accès officiel.
# MOONTON_API_BASE=
# MOONTON_API_KEY=

# Liquipedia (données e-sport, licence CC BY-SA). User-Agent identifiable obligatoire.
# LIQUIPEDIA_USER_AGENT="MLBB-Companion/0.1 (contact: ton-email)"
