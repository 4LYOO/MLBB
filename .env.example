# Variables utilisées au build (aucune n'est secrète).
# Préfixe d'URL du site (GitHub Pages d'un dépôt de projet : /<nom-du-dépôt>). Vide en local.
# NEXT_PUBLIC_BASE_PATH=/MLBB
# Lien du dépôt (bouton « Lancer une synchro maintenant » de la page Sources)
# NEXT_PUBLIC_REPO_URL=https://github.com/4LYOO/MLBB

# Script de synchronisation (npm run data:publish)
# PAGES_URL=https://4lyoo.github.io/MLBB   # pour repartir de l'historique déjà publié
# MLBBIO_DELAY_MS=1200                     # pause entre deux requêtes vers mlbb.io
# Derrière un proxy HTTPS : NODE_USE_ENV_PROXY=1
